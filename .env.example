# Copy to .env (never commit it) or set these in your host's dashboard.

# "mock" = fake payments for local testing; "nwc" = real Lightning via Nostr Wallet Connect
LIGHTNING_BACKEND=mock
# Connection string from your wallet (Alby Hub, Coinos, Primal, ...).
# Create it with ONLY make_invoice and lookup_invoice permissions, never pay permissions.
NWC_URL=

# "mock" = canned answers, free; "anthropic" = real Claude (needs ANTHROPIC_API_KEY)
AI_BACKEND=mock
ANTHROPIC_API_KEY=
# claude-opus-5 (default), claude-sonnet-5 or claude-haiku-4-5 (cheapest per request)
AI_MODEL=claude-opus-5

# Price = worst-case AI cost x PRICE_MARKUP, never below MIN_SATS
PRICE_MARKUP=2
MIN_SATS=21
# Used only if the live BTC price (mempool.space) can't be fetched
BTC_USD_FALLBACK=100000

INVOICE_EXPIRY_SECS=600
MAX_INPUT_CHARS=20000
PORT=3000
